{
  "name": "kirakira-iris",
  "version": "0.2.0",
  "description": "Chinese-aware Aho-Corasick keyword moderation and queued, rate-limited OpenRouter AI review.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc -p test/tsconfig.json",
    "test": "npm run build && node scripts/test.mjs",
    "check": "npm run typecheck && node scripts/test.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "release:check": "node scripts/check-release.mjs",
    "release": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KIRAKIRA-DOUGA/KIRAKIRA-Iris.git"
  },
  "bugs": {
    "url": "https://github.com/KIRAKIRA-DOUGA/KIRAKIRA-Iris/issues"
  },
  "homepage": "https://github.com/KIRAKIRA-DOUGA/KIRAKIRA-Iris#readme",
  "keywords": [
    "moderation",
    "content-safety",
    "openrouter",
    "nemotron",
    "keywords",
    "typescript",
    "kirakira"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "opencc-js": "1.4.2"
  }
}
